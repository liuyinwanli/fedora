input type:touchpad {
  events disabled
}

input type:pointer {
  left_handed disabled
  tap enabled
  natural_scroll disabled
  dwt enabled
  accel_profile "flat" # 禁用鼠标加速（默认启用；要手动设置，请使用 "adaptive" 而不是 "flat"）
  pointer_accel 0.2 # 设置鼠标灵敏度（在 -1 和 1 之间）
}
# output eDP-1 disable
# output HDMI-A-1 mode 3840x2160@30Hz position 0 0 scale 1.2
# output eDP-1 mode 1920x1080@60Hz position 3840 0 scale 1.0
# workspace 1 output eDP-1

seat * xcursor_theme Adwaita 40
